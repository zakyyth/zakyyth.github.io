<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>VC Card Algeria — Fast &amp; Secure Digital Payments</title>
<meta name="description" content="VC Card Algeria — Virtual Visa Cards, international online payments and digital financial services in Algeria.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ==========================================================================
   VC CARD ALGERIA — Premium Fintech Design System
   ========================================================================== */

:root{
  --navy-deep:#050f1a;
  --navy:#071726;
  --navy-soft:#0d2438;
  --navy-elevated:#123049;
  --gold:#FFD56A;
  --gold-bright:#FFE8AD;
  --gold-deep:#E3A93D;
  --white:#F4F8FC;
  --mist:#9FB3C8;
  --line:rgba(255,213,106,0.14);
  --glass:rgba(255,255,255,0.045);
  --glass-strong:rgba(255,255,255,0.07);
  --glass-border:rgba(255,255,255,0.09);
  --shadow-gold:0 0 60px rgba(255,213,106,0.18);
  --ease:cubic-bezier(.16,.84,.44,1);
  --font-en:'Poppins', sans-serif;
  --font-ar:'Cairo', sans-serif;
}

*{margin:0;padding:0;box-sizing:border-box;}

html{
  scroll-behavior:smooth;
  -webkit-tap-highlight-color:transparent;
}

body{
  background:var(--navy);
  color:var(--white);
  font-family:var(--font-en);
  overflow-x:hidden;
  position:relative;
  line-height:1.6;
}

html[dir="rtl"] body{ font-family:var(--font-ar); }

/* Custom scrollbar */
::-webkit-scrollbar{width:10px;}
::-webkit-scrollbar-track{background:var(--navy-deep);}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--gold),var(--gold-deep));border-radius:10px;}
::-webkit-scrollbar-thumb:hover{background:var(--gold-bright);}
*{scrollbar-width:thin;scrollbar-color:var(--gold-deep) var(--navy-deep);}

::selection{background:var(--gold);color:var(--navy-deep);}

img,svg{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
ul{list-style:none;}

@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:0.001ms !important;animation-iteration-count:1 !important;transition-duration:0.001ms !important;scroll-behavior:auto !important;}
}

/* ==========================================================================
   Background atmosphere
   ========================================================================== */

.bg-atmosphere{
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  overflow:hidden;
  background:
    radial-gradient(ellipse 90% 60% at 15% -10%, rgba(255,213,106,0.10), transparent 60%),
    radial-gradient(ellipse 70% 50% at 100% 20%, rgba(80,140,200,0.10), transparent 60%),
    linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 40%, var(--navy) 100%);
}
.bg-grid{
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, black, transparent 70%);
}
.orb{
  position:absolute;
  border-radius:50%;
  filter:blur(80px);
  opacity:.55;
  animation:float-orb 18s ease-in-out infinite;
}
.orb-1{width:480px;height:480px;top:-120px;left:-100px;background:radial-gradient(circle, rgba(255,213,106,0.35), transparent 70%);}
.orb-2{width:420px;height:420px;top:20%;right:-140px;background:radial-gradient(circle, rgba(94,158,214,0.28), transparent 70%);animation-delay:-6s;}
.orb-3{width:520px;height:520px;bottom:-160px;left:30%;background:radial-gradient(circle, rgba(255,213,106,0.18), transparent 70%);animation-delay:-11s;}

@keyframes float-orb{
  0%,100%{transform:translate(0,0) scale(1);}
  50%{transform:translate(30px,-40px) scale(1.08);}
}

/* ==========================================================================
   Loader
   ========================================================================== */

.loader{
  position:fixed;inset:0;z-index:9999;
  background:var(--navy-deep);
  display:flex;align-items:center;justify-content:center;
  transition:opacity .7s var(--ease), visibility .7s var(--ease);
}
.loader.hide{opacity:0;visibility:hidden;}
.loader-mark{
  width:64px;height:64px;
  position:relative;
}
.loader-mark svg{width:100%;height:100%;}
.loader-ring{
  fill:none;stroke:url(#loaderGrad);stroke-width:3;
  stroke-linecap:round;
  stroke-dasharray:180;
  stroke-dashoffset:180;
  animation:loader-draw 1.4s var(--ease) infinite;
  transform-origin:center;
}
@keyframes loader-draw{
  0%{stroke-dashoffset:180;transform:rotate(0deg);}
  50%{stroke-dashoffset:40;transform:rotate(180deg);}
  100%{stroke-dashoffset:180;transform:rotate(360deg);}
}

/* ==========================================================================
   Layout helpers
   ========================================================================== */

.container{
  width:100%;
  max-width:1240px;
  margin:0 auto;
  padding:0 24px;
}
section{position:relative;z-index:1;}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-size:12.5px;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--gold);
  padding:7px 16px;
  border:1px solid var(--line);
  border-radius:100px;
  background:rgba(255,213,106,0.06);
  margin-bottom:20px;
}
.eyebrow::before{
  content:'';
  width:6px;height:6px;
  border-radius:50%;
  background:var(--gold);
  box-shadow:0 0 8px 2px rgba(255,213,106,0.7);
}

.section-head{
  max-width:640px;
  margin-bottom:56px;
}
.section-head.center{margin-left:auto;margin-right:auto;text-align:center;}
.section-title{
  font-size:clamp(28px,4vw,42px);
  font-weight:700;
  line-height:1.2;
  letter-spacing:-0.01em;
  margin-bottom:14px;
}
.section-title .accent{
  background:linear-gradient(120deg, var(--gold-bright), var(--gold) 60%, var(--gold-deep));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.section-sub{
  color:var(--mist);
  font-size:16.5px;
  font-weight:300;
}

.gold-btn, .ghost-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding:16px 30px;
  border-radius:14px;
  font-weight:600;
  font-size:15px;
  letter-spacing:.01em;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease), border-color .35s var(--ease);
  white-space:nowrap;
  position:relative;
}
.gold-btn{
  color:var(--navy-deep);
  background:linear-gradient(120deg, var(--gold-bright), var(--gold) 55%, var(--gold-deep));
  background-size:180% 180%;
  background-position:0% 50%;
  box-shadow:0 8px 30px -6px rgba(255,213,106,0.55);
}
.gold-btn:hover{
  transform:translateY(-3px);
  background-position:100% 50%;
  box-shadow:0 14px 40px -6px rgba(255,213,106,0.7);
}
.ghost-btn{
  color:var(--white);
  background:var(--glass);
  border:1px solid var(--glass-border);
  backdrop-filter:blur(14px);
}
.ghost-btn:hover{
  border-color:rgba(255,213,106,0.5);
  background:rgba(255,213,106,0.06);
  transform:translateY(-3px);
}
.btn-row{display:flex;gap:16px;flex-wrap:wrap;}

/* Reveal on scroll */
.reveal{
  opacity:0;
  transform:translateY(28px);
  transition:opacity .9s var(--ease), transform .9s var(--ease);
}
.reveal.in{opacity:1;transform:translateY(0);}
.reveal-stagger > *{transition-delay:calc(var(--i,0) * 90ms);}

/* ==========================================================================
   Navigation
   ========================================================================== */

.navbar{
  position:fixed;top:0;left:0;right:0;
  z-index:1000;
  padding:20px 0;
  transition:padding .4s var(--ease), background .4s var(--ease);
}
.navbar.scrolled{
  padding:12px 0;
  background:rgba(5,15,26,0.72);
  backdrop-filter:blur(18px) saturate(140%);
  border-bottom:1px solid var(--glass-border);
}
.nav-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}
.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:700;
  font-size:19px;
  letter-spacing:-0.01em;
}
.brand-mark{width:38px;height:38px;flex-shrink:0;}
.brand-name b{color:var(--gold);font-weight:800;}

.nav-links{
  display:flex;
  align-items:center;
  gap:6px;
  padding:6px;
  background:var(--glass);
  border:1px solid var(--glass-border);
  border-radius:100px;
  backdrop-filter:blur(14px);
}
.nav-links a{
  padding:10px 18px;
  border-radius:100px;
  font-size:14.5px;
  font-weight:500;
  color:var(--mist);
  transition:color .3s, background .3s;
}
.nav-links a:hover{color:var(--white);background:rgba(255,255,255,0.05);}

.nav-actions{display:flex;align-items:center;gap:12px;}

.lang-switch{
  display:flex;
  align-items:center;
  gap:7px;
  padding:9px 16px;
  border-radius:100px;
  border:1px solid var(--glass-border);
  background:var(--glass);
  font-size:13.5px;
  font-weight:600;
  color:var(--white);
  transition:border-color .3s, background .3s, transform .3s;
}
.lang-switch:hover{border-color:var(--gold);transform:translateY(-2px);}
.lang-switch svg{width:16px;height:16px;stroke:var(--gold);}

.nav-cta{display:inline-flex;padding:11px 22px;font-size:14px;}

.nav-toggle{
  display:none;
  width:42px;height:42px;
  border-radius:12px;
  border:1px solid var(--glass-border);
  background:var(--glass);
  align-items:center;justify-content:center;
  flex-direction:column;
  gap:5px;
}
.nav-toggle span{width:18px;height:2px;background:var(--gold);border-radius:2px;transition:transform .3s,opacity .3s;}
.nav-toggle.active span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.nav-toggle.active span:nth-child(2){opacity:0;}
.nav-toggle.active span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

.mobile-panel{
  display:none;
  position:fixed;
  top:0; right:0; bottom:0;
  width:min(78vw,340px);
  background:rgba(7,23,38,0.98);
  backdrop-filter:blur(20px);
  border-left:1px solid var(--glass-border);
  z-index:1100;
  padding:100px 28px 40px;
  transform:translateX(100%);
  transition:transform .5s var(--ease);
  flex-direction:column;
  gap:6px;
  overflow-y:auto;
}
html[dir="rtl"] .mobile-panel{ right:auto; left:0; border-left:none; border-right:1px solid var(--glass-border); transform:translateX(-100%); }
.mobile-panel.open{transform:translateX(0);}
.mobile-panel a{
  padding:16px 6px;
  font-size:18px;
  font-weight:500;
  border-bottom:1px solid rgba(255,255,255,0.06);
  color:var(--white);
}
.mobile-backdrop{
  display:none;
  position:fixed;inset:0;z-index:1050;
  background:rgba(0,0,0,0.55);
  opacity:0;transition:opacity .4s;
}
.mobile-backdrop.open{opacity:1;}

/* ==========================================================================
   Hero
   ========================================================================== */

.hero{
  min-height:100vh;
  display:flex;
  align-items:center;
  padding:150px 0 90px;
}
.hero-inner{
  display:grid;
  grid-template-columns:1.05fr 0.95fr;
  gap:50px;
  align-items:center;
}
.hero-title{
  font-size:clamp(36px,5.4vw,64px);
  font-weight:800;
  line-height:1.12;
  letter-spacing:-0.02em;
  margin-bottom:22px;
}
.hero-title .gold-text{
  background:linear-gradient(120deg, var(--gold-bright), var(--gold) 50%, var(--gold-deep));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  position:relative;
}
.hero-sub{
  font-size:18px;
  font-weight:300;
  color:var(--mist);
  max-width:520px;
  margin-bottom:36px;
}
.hero-badges{
  display:flex;
  gap:28px;
  margin-top:44px;
  flex-wrap:wrap;
}
.hero-badge{display:flex;align-items:center;gap:10px;}
.hero-badge svg{width:20px;height:20px;stroke:var(--gold);flex-shrink:0;}
.hero-badge span{font-size:13.5px;color:var(--mist);font-weight:500;}

/* Floating card visual */
.hero-visual{
  position:relative;
  height:480px;
  display:flex;
  align-items:center;
  justify-content:center;
  perspective:1400px;
}
.card-glow{
  position:absolute;
  width:360px;height:360px;
  background:radial-gradient(circle, rgba(255,213,106,0.35), transparent 68%);
  filter:blur(20px);
  animation:pulse-glow 4s ease-in-out infinite;
}
@keyframes pulse-glow{
  0%,100%{opacity:.55;transform:scale(1);}
  50%{opacity:.9;transform:scale(1.12);}
}
.card-stage{
  position:relative;
  width:340px;
  height:214px;
  animation:card-float 6s ease-in-out infinite;
  transform-style:preserve-3d;
}
@keyframes card-float{
  0%,100%{transform:translateY(0) rotateY(-18deg) rotateX(6deg);}
  50%{transform:translateY(-18px) rotateY(-12deg) rotateX(3deg);}
}
.vcard{
  position:absolute;inset:0;
  border-radius:22px;
  overflow:hidden;
  background:linear-gradient(135deg, #0d2438 0%, #071726 55%, #050f1a 100%);
  border:1px solid rgba(255,213,106,0.35);
  box-shadow:0 40px 80px -20px rgba(0,0,0,0.6), 0 0 60px -10px rgba(255,213,106,0.25), inset 0 1px 0 rgba(255,255,255,0.08);
  padding:26px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.vcard::before{
  content:'';
  position:absolute;
  top:-60%;left:-20%;
  width:140%;height:220%;
  background:linear-gradient(115deg, transparent 40%, rgba(255,255,255,0.10) 48%, rgba(255,213,106,0.18) 51%, transparent 60%);
  animation:sheen 5s ease-in-out infinite;
}
@keyframes sheen{
  0%{transform:translateX(-30%) translateY(-10%);}
  50%{transform:translateX(10%) translateY(6%);}
  100%{transform:translateX(-30%) translateY(-10%);}
}
.vcard-top{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:2;}
.vcard-chip{
  width:42px;height:32px;
  border-radius:7px;
  background:linear-gradient(135deg, var(--gold-bright), var(--gold-deep));
  position:relative;
  box-shadow:0 2px 6px rgba(0,0,0,0.4);
}
.vcard-chip::before, .vcard-chip::after{
  content:'';position:absolute;background:rgba(7,23,38,0.5);
}
.vcard-chip::before{top:50%;left:0;right:0;height:1.5px;transform:translateY(-50%);}
.vcard-chip::after{left:50%;top:0;bottom:0;width:1.5px;transform:translateX(-50%);}
.vcard-brand{font-size:13px;font-weight:700;letter-spacing:.08em;color:var(--gold);}
.vcard-number{
  font-size:18px;
  letter-spacing:.14em;
  font-weight:500;
  color:rgba(244,248,252,0.92);
  position:relative;z-index:2;
  font-variant-numeric:tabular-nums;
}
.vcard-bottom{display:flex;justify-content:space-between;align-items:flex-end;position:relative;z-index:2;}
.vcard-label{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--mist);margin-bottom:3px;}
.vcard-value{font-size:13px;font-weight:600;color:var(--white);letter-spacing:.03em;}
.vcard-wave{width:26px;height:26px;opacity:.8;}

.card-stage-back{
  position:absolute;
  width:340px;height:214px;
  top:36px; left:-4px;
  border-radius:22px;
  background:linear-gradient(135deg, rgba(255,213,106,0.14), rgba(255,213,106,0.02));
  border:1px solid rgba(255,213,106,0.18);
  transform:rotateY(-18deg) rotateX(6deg) translateZ(-40px);
  filter:blur(0.5px);
}
html[dir="rtl"] .card-stage-back{ left:auto; right:-4px; }

.float-chip{
  position:absolute;
  padding:11px 16px;
  border-radius:14px;
  background:var(--glass-strong);
  border:1px solid var(--glass-border);
  backdrop-filter:blur(16px);
  display:flex;
  align-items:center;
  gap:9px;
  font-size:12.5px;
  font-weight:600;
  box-shadow:0 12px 30px -8px rgba(0,0,0,0.5);
  animation:chip-drift 5.5s ease-in-out infinite;
}
.float-chip svg{width:16px;height:16px;stroke:var(--gold);flex-shrink:0;}
.float-chip.c1{top:8%;left:-6%;animation-delay:.3s;}
.float-chip.c2{bottom:10%;right:-8%;animation-delay:1.4s;}
html[dir="rtl"] .float-chip.c1{left:auto;right:-6%;}
html[dir="rtl"] .float-chip.c2{right:auto;left:-8%;}
@keyframes chip-drift{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-12px);}
}

/* ==========================================================================
   Marquee / trust strip
   ========================================================================== */
.trust-strip{
  border-top:1px solid var(--glass-border);
  border-bottom:1px solid var(--glass-border);
  padding:22px 0;
  overflow:hidden;
  background:rgba(255,255,255,0.015);
}
.marquee{
  display:flex;
  gap:64px;
  width:max-content;
  animation:marquee-scroll 26s linear infinite;
}
html[dir="rtl"] .marquee{ animation-name:marquee-scroll-rtl; }
.marquee span{
  font-size:14px;
  font-weight:600;
  letter-spacing:.06em;
  color:var(--mist);
  display:flex;align-items:center;gap:10px;
  white-space:nowrap;
}
.marquee span::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--gold);}
@keyframes marquee-scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes marquee-scroll-rtl{from{transform:translateX(0);}to{transform:translateX(50%);}}

/* ==========================================================================
   Services
   ========================================================================== */

.services{padding:130px 0 90px;}
.services-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}
.service-card{
  position:relative;
  padding:34px 28px;
  border-radius:20px;
  background:var(--glass);
  border:1px solid var(--glass-border);
  backdrop-filter:blur(14px);
  overflow:hidden;
  transition:transform .5s var(--ease), border-color .5s var(--ease), background .5s var(--ease);
}
.service-card::after{
  content:'';
  position:absolute;inset:0;
  border-radius:20px;
  padding:1px;
  background:linear-gradient(135deg, rgba(255,213,106,0.5), transparent 40%);
  -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;
  mask-composite:exclude;
  opacity:0;
  transition:opacity .5s;
}
.service-card:hover{
  transform:translateY(-8px);
  border-color:transparent;
  background:rgba(255,255,255,0.06);
  box-shadow:0 26px 50px -20px rgba(0,0,0,0.55), 0 0 40px -14px rgba(255,213,106,0.25);
}
.service-card:hover::after{opacity:1;}
.service-icon{
  width:56px;height:56px;
  border-radius:15px;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg, rgba(255,213,106,0.16), rgba(255,213,106,0.03));
  border:1px solid var(--line);
  margin-bottom:22px;
  transition:transform .5s var(--ease), background .5s;
}
.service-icon svg{width:26px;height:26px;stroke:var(--gold);}
.service-card:hover .service-icon{transform:scale(1.08) rotate(-6deg);background:rgba(255,213,106,0.2);}
.service-card h3{font-size:19px;font-weight:600;margin-bottom:10px;letter-spacing:-0.01em;}
.service-card p{font-size:14.5px;color:var(--mist);font-weight:300;line-height:1.7;}
.service-num{
  position:absolute;top:24px;
  inset-inline-end:26px;
  font-size:13px;
  font-weight:700;
  color:rgba(255,213,106,0.35);
  letter-spacing:.05em;
}

/* ==========================================================================
   Why Us
   ========================================================================== */

.why-us{padding:90px 0;}
.why-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  background:var(--glass-border);
  border:1px solid var(--glass-border);
  border-radius:20px;
  overflow:hidden;
}
.why-card{
  background:var(--navy);
  padding:36px 30px;
  display:flex;
  flex-direction:column;
  gap:16px;
  transition:background .4s;
  position:relative;
}
.why-card:hover{background:var(--navy-soft);}
.why-icon{
  width:48px;height:48px;
  border-radius:13px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,213,106,0.08);
}
.why-icon svg{width:23px;height:23px;stroke:var(--gold);}
.why-card h3{font-size:17px;font-weight:600;}
.why-card p{font-size:14px;color:var(--mist);font-weight:300;line-height:1.65;}

/* ==========================================================================
   How it works
   ========================================================================== */

.how{padding:130px 0 90px;}
.timeline{
  position:relative;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:24px;
  margin-top:20px;
}
.timeline::before{
  content:'';
  position:absolute;
  top:34px;
  left:12.5%;right:12.5%;
  height:1px;
  background:repeating-linear-gradient(90deg, rgba(255,213,106,0.4) 0 10px, transparent 10px 20px);
}
.tl-step{
  position:relative;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.tl-num{
  width:68px;height:68px;
  border-radius:50%;
  background:linear-gradient(145deg, var(--navy-elevated), var(--navy-soft));
  border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;font-weight:800;
  color:var(--gold);
  margin-bottom:22px;
  position:relative;
  z-index:2;
  box-shadow:0 0 0 8px var(--navy), 0 20px 30px -10px rgba(0,0,0,0.5);
  transition:transform .4s var(--ease), box-shadow .4s var(--ease);
}
.tl-step:hover .tl-num{transform:scale(1.08);box-shadow:0 0 0 8px var(--navy), 0 0 30px rgba(255,213,106,0.4);}
.tl-step h3{font-size:17px;font-weight:600;margin-bottom:8px;}
.tl-step p{font-size:13.5px;color:var(--mist);font-weight:300;max-width:210px;}

/* ==========================================================================
   Stats
   ========================================================================== */

.stats{padding:90px 0;}
.stats-panel{
  border-radius:26px;
  background:linear-gradient(135deg, rgba(255,213,106,0.09), rgba(255,255,255,0.02));
  border:1px solid var(--line);
  padding:56px 40px;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:24px;
  position:relative;
  overflow:hidden;
}
.stats-panel::before{
  content:'';position:absolute;
  width:400px;height:400px;
  background:radial-gradient(circle, rgba(255,213,106,0.15), transparent 70%);
  top:-160px; inset-inline-end:-120px;
  filter:blur(20px);
}
.stat{text-align:center;position:relative;z-index:1;}
.stat-num{
  font-size:clamp(32px,4vw,46px);
  font-weight:800;
  background:linear-gradient(120deg, var(--gold-bright), var(--gold));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  letter-spacing:-0.02em;
  margin-bottom:8px;
}
.stat-label{font-size:13.5px;color:var(--mist);font-weight:500;letter-spacing:.02em;}

/* ==========================================================================
   FAQ
   ========================================================================== */

.faq{padding:130px 0 90px;}
.faq-wrap{max-width:760px;margin:0 auto;}
.faq-item{
  border:1px solid var(--glass-border);
  border-radius:16px;
  margin-bottom:14px;
  background:var(--glass);
  overflow:hidden;
  transition:border-color .3s;
}
.faq-item.open{border-color:rgba(255,213,106,0.4);}
.faq-q{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:22px 26px;
  font-size:16px;
  font-weight:500;
  text-align:start;
}
.faq-q .plus{
  width:30px;height:30px;
  flex-shrink:0;
  border-radius:9px;
  background:rgba(255,213,106,0.1);
  display:flex;align-items:center;justify-content:center;
  position:relative;
  transition:transform .4s var(--ease), background .4s;
}
.faq-q .plus::before, .faq-q .plus::after{
  content:'';position:absolute;background:var(--gold);border-radius:2px;transition:transform .35s var(--ease), opacity .35s;
}
.faq-q .plus::before{width:12px;height:2px;}
.faq-q .plus::after{width:2px;height:12px;}
.faq-item.open .plus{background:var(--gold);transform:rotate(180deg);}
.faq-item.open .plus::before,.faq-item.open .plus::after{background:var(--navy-deep);}
.faq-item.open .plus::after{opacity:0;}
.faq-a{
  max-height:0;
  overflow:hidden;
  transition:max-height .5s var(--ease);
}
.faq-a-inner{
  padding:0 26px 24px;
  color:var(--mist);
  font-size:14.5px;
  font-weight:300;
  line-height:1.75;
}

/* ==========================================================================
   Contact
   ========================================================================== */

.contact{padding:90px 0 130px;}
.contact-panel{
  border-radius:28px;
  background:linear-gradient(160deg, var(--navy-soft), var(--navy-deep));
  border:1px solid var(--line);
  padding:64px 48px;
  position:relative;
  overflow:hidden;
  text-align:center;
}
.contact-panel::before{
  content:'';
  position:absolute;
  width:600px;height:300px;
  background:radial-gradient(ellipse, rgba(255,213,106,0.14), transparent 70%);
  top:-100px;left:50%;transform:translateX(-50%);
}
.contact-methods{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  margin-top:44px;
  position:relative;z-index:1;
}
.contact-card{
  padding:30px 24px;
  border-radius:18px;
  background:var(--glass);
  border:1px solid var(--glass-border);
  backdrop-filter:blur(14px);
  transition:transform .45s var(--ease), border-color .45s, background .45s;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:14px;
}
.contact-card:hover{transform:translateY(-6px);border-color:rgba(255,213,106,0.4);background:rgba(255,213,106,0.05);}
.contact-icon{
  width:54px;height:54px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg, rgba(255,213,106,0.2), rgba(255,213,106,0.04));
  border:1px solid var(--line);
}
.contact-icon svg{width:24px;height:24px;stroke:var(--gold);}
.contact-card h4{font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:var(--mist);font-weight:600;}
.contact-card .value{font-size:16.5px;font-weight:600;color:var(--white);direction:ltr;}

/* ==========================================================================
   Footer
   ========================================================================== */

footer{
  border-top:1px solid var(--glass-border);
  padding:50px 0 30px;
  position:relative;
  z-index:1;
}
.footer-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:24px;
  padding-bottom:30px;
  margin-bottom:24px;
  border-bottom:1px solid var(--glass-border);
}
.footer-links{display:flex;gap:28px;flex-wrap:wrap;}
.footer-links a{font-size:14px;color:var(--mist);font-weight:400;transition:color .3s;}
.footer-links a:hover{color:var(--gold);}
.footer-bottom{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:16px;
}
.footer-bottom p{font-size:13px;color:var(--mist);font-weight:300;}
.social-row{display:flex;gap:10px;}
.social-btn{
  width:40px;height:40px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:var(--glass);
  border:1px solid var(--glass-border);
  transition:transform .35s var(--ease), border-color .35s, background .35s;
}
.social-btn:hover{transform:translateY(-4px);border-color:var(--gold);background:rgba(255,213,106,0.1);}
.social-btn svg{width:17px;height:17px;stroke:var(--gold);}

/* ==========================================================================
   Responsive
   ========================================================================== */

@media (max-width:1024px){
  .hero-inner{grid-template-columns:1fr;}
  .hero-visual{height:380px;order:-1;}
  .services-grid{grid-template-columns:repeat(2,1fr);}
  .why-grid{grid-template-columns:repeat(2,1fr);}
  .contact-methods{grid-template-columns:1fr;}
  .stats-panel{grid-template-columns:repeat(2,1fr);}
}

@media (max-width:860px){
  .nav-links{display:none;}
  .nav-toggle{display:flex;}
  .mobile-panel, .mobile-backdrop{display:flex;flex-direction:column;}
  .timeline{grid-template-columns:1fr;gap:36px;}
  .timeline::before{display:none;}
}

@media (max-width:640px){
  .container{padding:0 18px;}
  .hero{padding:130px 0 60px;}
  .services-grid{grid-template-columns:1fr;}
  .why-grid{grid-template-columns:1fr;}
  .stats-panel{grid-template-columns:1fr 1fr;padding:40px 22px;gap:30px 16px;}
  .contact-panel{padding:44px 22px;}
  .card-stage, .vcard, .card-stage-back{width:290px;height:182px;}
  .footer-inner{flex-direction:column;align-items:flex-start;}
  .footer-bottom{flex-direction:column;align-items:flex-start;}
  .float-chip{font-size:11px;padding:9px 12px;}
  .float-chip.c1{left:2%;}
  .float-chip.c2{right:2%;}
  html[dir="rtl"] .float-chip.c1{right:2%;}
  html[dir="rtl"] .float-chip.c2{left:2%;}
}

/* Focus visibility */
a:focus-visible, button:focus-visible{
  outline:2px solid var(--gold);
  outline-offset:3px;
  border-radius:8px;
}
</style>
</head>
<body>

<!-- Loader -->
<div class="loader" id="loader">
  <div class="loader-mark">
    <svg viewBox="0 0 64 64">
      <defs>
        <linearGradient id="loaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFE8AD"/>
          <stop offset="100%" stop-color="#E3A93D"/>
        </linearGradient>
      </defs>
      <circle class="loader-ring" cx="32" cy="32" r="26"></circle>
    </svg>
  </div>
</div>

<!-- Atmosphere -->
<div class="bg-atmosphere">
  <div class="bg-grid"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
</div>

<!-- Navbar -->
<header class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href="#home" class="brand">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
        <rect x="1" y="1" width="38" height="38" rx="11" fill="url(#brandGrad)" stroke="#FFD56A" stroke-opacity="0.35"/>
        <path d="M12 15L20 27L28 15" stroke="#071726" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        <defs>
          <linearGradient id="brandGrad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FFE8AD"/>
            <stop offset="1" stop-color="#E3A93D"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="brand-name" data-i18n="brand">VC <b>Card</b> Algeria</span>
    </a>

    <nav class="nav-links">
      <a href="#home" data-i18n="nav_home">Home</a>
      <a href="#services" data-i18n="nav_services">Services</a>
      <a href="#why" data-i18n="nav_why">Why Us</a>
      <a href="#faq" data-i18n="nav_faq">FAQ</a>
      <a href="#contact" data-i18n="nav_contact">Contact</a>
    </nav>

    <div class="nav-actions">
      <button class="lang-switch" id="langSwitch">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a13 13 0 0 1 0 18M12 3a13 13 0 0 0 0 18"></path></svg>
        <span id="langLabel">العربية</span>
      </button>
      <a href="#contact" class="gold-btn nav-cta" data-i18n="nav_cta">Contact Us</a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-backdrop" id="mobileBackdrop"></div>
<nav class="mobile-panel" id="mobilePanel">
  <a href="#home" data-i18n="nav_home">Home</a>
  <a href="#services" data-i18n="nav_services">Services</a>
  <a href="#why" data-i18n="nav_why">Why Us</a>
  <a href="#faq" data-i18n="nav_faq">FAQ</a>
  <a href="#contact" data-i18n="nav_contact">Contact</a>
</nav>

<main id="home">

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy reveal in">
        <div class="eyebrow" data-i18n="hero_eyebrow">Digital Payments, Reinvented in Algeria</div>
        <h1 class="hero-title" data-i18n="hero_title">Fast &amp; <span class="gold-text">Secure</span> Digital Payment Solutions</h1>
        <p class="hero-sub" data-i18n="hero_sub">Virtual Visa Cards, international online payments and digital financial services in Algeria.</p>
        <div class="btn-row">
          <a href="#contact" class="gold-btn" data-i18n="hero_btn1">Contact Us</a>
          <a href="#services" class="ghost-btn" data-i18n="hero_btn2">Our Services</a>
        </div>
        <div class="hero-badges">
          <div class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path></svg>
            <span data-i18n="hero_badge1">Bank-grade security</span>
          </div>
          <div class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"></path></svg>
            <span data-i18n="hero_badge2">Instant activation</span>
          </div>
          <div class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
            <span data-i18n="hero_badge3">24/7 support</span>
          </div>
        </div>
      </div>

      <div class="hero-visual reveal in">
        <div class="card-glow"></div>
        <div class="card-stage-back"></div>
        <div class="card-stage">
          <div class="vcard">
            <div class="vcard-top">
              <div class="vcard-chip"></div>
              <span class="vcard-brand">VC CARD</span>
            </div>
            <div class="vcard-number">5421&nbsp;&nbsp;••••&nbsp;&nbsp;••••&nbsp;&nbsp;8830</div>
            <div class="vcard-bottom">
              <div>
                <div class="vcard-label">CARD HOLDER</div>
                <div class="vcard-value">VC CARD ALGERIA</div>
              </div>
              <svg class="vcard-wave" viewBox="0 0 24 24" fill="none" stroke="#FFD56A" stroke-width="1.6"><path d="M2 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0"></path><path d="M2 17c2-4 4-4 6 0s4 4 6 0 4-4 6 0" opacity="0.5"></path></svg>
            </div>
          </div>
        </div>
        <div class="float-chip c1">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path></svg>
          <span data-i18n="chip1">Secured Transfer</span>
        </div>
        <div class="float-chip c2">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-8-8"></path><path d="M20 4L12 12"></path></svg>
          <span data-i18n="chip2">Instant Top-Up</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="trust-strip">
    <div class="marquee" id="marquee">
      <span data-i18n="trust1">Virtual Visa Cards</span>
      <span data-i18n="trust2">International Payments</span>
      <span data-i18n="trust3">PayPal &amp; Wallet Top-Up</span>
      <span data-i18n="trust4">Secure Digital Transactions</span>
      <span data-i18n="trust5">Trusted Across Algeria</span>
      <span data-i18n="trust1">Virtual Visa Cards</span>
      <span data-i18n="trust2">International Payments</span>
      <span data-i18n="trust3">PayPal &amp; Wallet Top-Up</span>
      <span data-i18n="trust4">Secure Digital Transactions</span>
      <span data-i18n="trust5">Trusted Across Algeria</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" data-i18n="services_eyebrow">What We Offer</div>
        <h2 class="section-title" data-i18n="services_title">Everything you need for <span class="accent" data-i18n="services_title_accent">digital payments</span></h2>
        <p class="section-sub" data-i18n="services_sub">A complete suite of digital financial services designed for speed, security and simplicity.</p>
      </div>

      <div class="services-grid reveal-stagger">
        <div class="service-card reveal" style="--i:0">
          <span class="service-num">01</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="3"></rect><path d="M2 10h20"></path><path d="M6 15h4"></path></svg>
          </div>
          <h3 data-i18n="s1_title">Virtual Visa Card Creation</h3>
          <p data-i18n="s1_desc">Get your own virtual card issued in minutes, ready for secure online use worldwide.</p>
        </div>

        <div class="service-card reveal" style="--i:1">
          <span class="service-num">02</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h13"></path><path d="M12 5l7 7-7 7"></path><path d="M21 5v14"></path></svg>
          </div>
          <h3 data-i18n="s2_title">International Online Payments</h3>
          <p data-i18n="s2_desc">Pay any global platform or service with full confidence and complete security.</p>
        </div>

        <div class="service-card reveal" style="--i:2">
          <span class="service-num">03</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8.5 10a3.5 3.5 0 0 1 3.5-2c2 0 3.5 1 3.5 2.5S13.5 12.5 12 13c-2 .5-3.5 1.5-3.5 3S10 18 12 18a3.5 3.5 0 0 0 3.5-2"></path></svg>
          </div>
          <h3 data-i18n="s3_title">Account Top-Up</h3>
          <p data-i18n="s3_desc">Recharge your digital wallets and platforms quickly with transparent fees.</p>
        </div>

        <div class="service-card reveal" style="--i:3">
          <span class="service-num">04</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </div>
          <h3 data-i18n="s4_title">Digital Payment Assistance</h3>
          <p data-i18n="s4_desc">Personal guidance through every step of your online payment journey.</p>
        </div>

        <div class="service-card reveal" style="--i:4">
          <span class="service-num">05</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <h3 data-i18n="s5_title">Fast Customer Support</h3>
          <p data-i18n="s5_desc">A responsive team ready to help you around the clock, every day of the week.</p>
        </div>

        <div class="service-card reveal" style="--i:5">
          <span class="service-num">06</span>
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M3 9h18"></path><path d="M8 15h3"></path></svg>
          </div>
          <h3 data-i18n="s6_title">Order Tracking</h3>
          <p data-i18n="s6_desc">Follow up on every request with clear status updates from start to finish.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="why-us" id="why">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" data-i18n="why_eyebrow">Why VC Card</div>
        <h2 class="section-title" data-i18n="why_title">Built on <span class="accent" data-i18n="why_title_accent">trust</span> and precision</h2>
        <p class="section-sub" data-i18n="why_sub">The reasons thousands of customers across Algeria choose us for their digital payments.</p>
      </div>

      <div class="why-grid reveal">
        <div class="why-card">
          <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"></path></svg></div>
          <h3 data-i18n="w1_title">Fast Processing</h3>
          <p data-i18n="w1_desc">Orders processed and delivered in record time, without unnecessary delays.</p>
        </div>
        <div class="why-card">
          <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path></svg></div>
          <h3 data-i18n="w2_title">Secure Transactions</h3>
          <p data-i18n="w2_desc">Every payment is protected with layered, bank-grade security protocols.</p>
        </div>
        <div class="why-card">
          <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path></svg></div>
          <h3 data-i18n="w3_title">Professional Support</h3>
          <p data-i18n="w3_desc">A dedicated team that treats every client with care and expertise.</p>
        </div>
        <div class="why-card">
          <div class="why-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"></path><circle cx="12" cy="12" r="9"></circle></svg></div>
          <h3 data-i18n="w4_title">Transparent Service</h3>
          <p data-i18n="w4_desc">Clear pricing and honest communication with absolutely no hidden fees.</p>
        </div>
        <div class="why-card">
